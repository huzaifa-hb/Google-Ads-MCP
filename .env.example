# MCP endpoint protection. Generate a long random value and store it in Secret Manager.
MCP_BEARER_TOKEN=replace-with-long-random-token

# Google Ads API credentials. Store real values in Secret Manager, never in source.
# Generate the refresh token with `google-ads-mcp-auth --client-secrets .\client_secret.json`.
# For local smoke tests, `google-ads-mcp-auth --write-env --prompt` can update this file.
GOOGLE_ADS_DEVELOPER_TOKEN=replace-with-developer-token
GOOGLE_ADS_CLIENT_ID=replace-with-oauth-client-id
GOOGLE_ADS_CLIENT_SECRET=replace-with-oauth-client-secret
GOOGLE_ADS_REFRESH_TOKEN=replace-with-offline-refresh-token

# Google Ads auth mode. Use shared_refresh_token for private/local servers.
# Use per_user_oauth for hosted Claude Web connectors so each user grants Ads access.
GOOGLE_ADS_AUTH_MODE=shared_refresh_token

# Optional manager account used as login_customer_id. Digits only, no dashes.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Runtime defaults.
GOOGLE_ADS_API_VERSION=v24
GOOGLE_ADS_GEO_TARGETS_CSV=
GOOGLE_ADS_METADATA_CACHE_TTL_SECONDS=3600
GOOGLE_ADS_METADATA_CACHE_MAX_ENTRIES=64
GOOGLE_ADS_METADATA_SNAPSHOT_PATH=
GOOGLE_PROJECT_ID=
HOST=0.0.0.0
PORT=8080

# Tool exposure and write safety. Default is safe_read_only.
GOOGLE_ADS_MCP_MODE=safe_read_only
GOOGLE_ADS_MCP_TOOLS_CONFIG=
GOOGLE_ADS_MCP_ALLOW_LEGACY_WRITE_DEFAULTS=false
GOOGLE_ADS_MCP_ENABLE_GENERIC_SERVICE_BRIDGE=false
GOOGLE_ADS_AUDIT_LOG_PATH=

# MCP auth mode. Bearer is the private-owner default.
GOOGLE_ADS_MCP_AUTH_MODE=bearer
GOOGLE_ADS_MCP_OAUTH_CLIENT_ID=
GOOGLE_ADS_MCP_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_MCP_BASE_URL=
GOOGLE_ADS_MCP_ALLOWED_EMAILS=
GOOGLE_ADS_MCP_ALLOWED_DOMAINS=
GOOGLE_ADS_MCP_TOKEN_STORAGE=local
GOOGLE_ADS_MCP_FIRESTORE_DATABASE=

# Development-only escape hatch. Keep false in Cloud Run.
ALLOW_UNAUTHENTICATED_MCP=false

